# Copy this file to config/.env and fill in your values

# Google AI Studio — FREE, generous limits (get key at https://aistudio.google.com/apikey)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# OpenRouter API — FREE cloud LLM tier (get key at https://openrouter.ai, no credit card needed)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Anthropic Claude API — paid fallback (optional, used only if OpenRouter is also unavailable)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Giphy API (for downloading emotion GIFs)
GIPHY_API_KEY=your_giphy_api_key_here

# Optional: Override brain name
BRAIN_NAME=Brain

# Optional: Set to true to run without real hardware (dev on laptop)
MOCK_HARDWARE=false

# Optional: Skip LLM calls entirely (for offline testing)
MOCK_LLM=false
